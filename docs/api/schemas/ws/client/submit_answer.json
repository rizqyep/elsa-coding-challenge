{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SubmitAnswerMessage",
  "description": "Answer the open question. Reply: answer_result or error, with the same id. Safe to resend (FR-18).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "type",
    "data",
    "id"
  ],
  "properties": {
    "v": {
      "const": 1,
      "description": "Protocol version."
    },
    "type": {
      "const": "submit_answer"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "questionId",
        "optionId"
      ],
      "properties": {
        "questionId": {
          "$ref": "../../common.json#/definitions/QuestionId"
        },
        "optionId": {
          "$ref": "../../common.json#/definitions/OptionId"
        }
      }
    },
    "id": {
      "$ref": "../../common.json#/definitions/RequestId"
    }
  },
  "examples": [
    {
      "v": 1,
      "type": "submit_answer",
      "id": "r-7",
      "data": {
        "questionId": "syn-03",
        "optionId": "syn-03-b"
      }
    }
  ]
}
