# Local configuration. `make up` copies this file to .env if .env doesn't exist.
# Every variable is documented in docs/planning/trd.md §2. Defaults below match the TRD.

# ---- Local stack (Docker Compose) -------------------------------------------
# Host ports are non-standard to avoid clashing with services already running locally.
REDIS_HOST_PORT=16379
POSTGRES_HOST_PORT=15432
POSTGRES_USER=quiz
POSTGRES_PASSWORD=quiz-local-only
POSTGRES_DB=quiz

# ---- Common (all services) --------------------------------------------------
APP_ENV=local
HTTP_ADDR=:8080
LOG_LEVEL=info
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
POSTGRES_DSN=postgres://quiz:quiz-local-only@postgres:5432/quiz?sslmode=disable
# HS256 secret for the mocked identity provider. Local development only.
AUTH_SIGNING_KEY=local-dev-only-signing-key-change-me-0123456789
SHUTDOWN_TIMEOUT=30s
DB_RETRY_BASE=100ms
DB_RETRY_MAX=5s
DB_RETRY_BUDGET=10s
OTEL_EXPORTER_OTLP_ENDPOINT=
QUIZ_DATA_TTL=24h

# ---- REST API ---------------------------------------------------------------
DEV_TOKENS_ENABLED=true
AUTH_TOKEN_TTL=15m
QUIZ_QUESTION_WINDOW_DEFAULT=15s
QUIZ_REVEAL_DEFAULT=5s
QUIZ_LOBBY_TIMEOUT=30m
QUIZ_CODE_MAX_ATTEMPTS=5

# ---- WebSocket gateway ------------------------------------------------------
WS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173
WS_MAX_MESSAGE_BYTES=4096
WS_READ_BUFFER_BYTES=1024
WS_WRITE_BUFFER_BYTES=1024
WS_SEND_QUEUE_SIZE=64
WS_PING_INTERVAL=25s
WS_PONG_TIMEOUT=60s
WS_RATE_PER_SEC=20
WS_RATE_BURST=40
WS_JOIN_ADMISSION_PER_SEC=500
WS_MAX_CONNECTIONS=20000
REGISTRY_SHARDS=64
PRESENCE_REFRESH=10s
PRESENCE_TTL=30s
QUESTION_CACHE_MAX_SETS=256
# 0 disables WAIT (the default stack has no replica). The `replica` profile sets 1.
REDIS_WAIT_REPLICAS=0
REDIS_WAIT_TIMEOUT=50ms

# ---- Worker -----------------------------------------------------------------
SCHED_TRANSITION_POLL=100ms
SCHED_LEADERBOARD_TICK=200ms
SCHED_FLUSH_POLL=1s
SCHED_CLAIM_BATCH=100
FLUSH_VISIBILITY_TIMEOUT=30s
